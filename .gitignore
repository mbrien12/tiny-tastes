# Ignore bundler config
/.bundle

# Ignore all environment files
/.env*
/config/master.key
/config/credentials/*.key

# Ignore default pids
/tmp/pids/*.pid

# Ignore all logfiles and tempfiles
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Storage
/storage/*
!/storage/.keep

# Assets
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore sqlite databases
/db/*.sqlite3
/db/*.sqlite3-*
/db/*.sqlite3-journal

# Ignore node modules
/node_modules

# macOS
.DS_Store
