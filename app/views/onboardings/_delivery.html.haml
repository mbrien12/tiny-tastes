%h2.text-xl.font-semibold.text-sage-800.mb-1 Delivery address
%p.text-sm.text-sage-500.mb-6 Where shall we deliver your weekly box?

- if user.errors.any?
  .bg-red-50.border.border-red-200.rounded-xl.p-4.mb-6
    %ul.list-disc.list-inside.text-sm.text-red-700
      - user.errors.full_messages.each do |msg|
        %li= msg

= form_with url: onboarding_path(onboarding.token), method: :patch, class: "space-y-5" do |f|
  .col-span-2
    %label.block.text-sm.font-medium.text-sage-700.mb-1 Address line 1
    %input{type: "text", name: "user[address_line_1]",
      value: user.address_line_1,
      placeholder: "12 Meadow Lane",
      autocomplete: "address-line1",
      class: "w-full border border-sage-200 rounded-xl px-4 py-3 text-sage-900 focus:outline-none focus:ring-2 focus:ring-sage-400 focus:border-transparent"}

  .col-span-2
    %label.block.text-sm.font-medium.text-sage-700.mb-1
      Address line 2
      %span.text-sage-400.font-normal (optional)
    %input{type: "text", name: "user[address_line_2]",
      value: user.address_line_2,
      placeholder: "Flat 3",
      autocomplete: "address-line2",
      class: "w-full border border-sage-200 rounded-xl px-4 py-3 text-sage-900 focus:outline-none focus:ring-2 focus:ring-sage-400 focus:border-transparent"}

  .grid.grid-cols-2.gap-4
    .col-span-1
      %label.block.text-sm.font-medium.text-sage-700.mb-1 Town / City
      %input{type: "text", name: "user[city]",
        value: user.city,
        placeholder: "London",
        autocomplete: "address-level2",
        class: "w-full border border-sage-200 rounded-xl px-4 py-3 text-sage-900 focus:outline-none focus:ring-2 focus:ring-sage-400 focus:border-transparent"}
    .col-span-1
      %label.block.text-sm.font-medium.text-sage-700.mb-1 Postcode
      %input{type: "text", name: "user[postcode]",
        value: user.postcode,
        placeholder: "SW1A 1AA",
        autocomplete: "postal-code",
        class: "w-full border border-sage-200 rounded-xl px-4 py-3 text-sage-900 focus:outline-none focus:ring-2 focus:ring-sage-400 focus:border-transparent"}

  %input{type: "submit", value: "Continue →",
    class: "w-full bg-sage-600 hover:bg-sage-700 text-white font-semibold text-lg py-4 rounded-2xl shadow transition-colors cursor-pointer mt-2"}

= form_with url: onboarding_path(onboarding.token), method: :patch do |f|
  = f.hidden_field :direction, value: "back", name: "direction"
  = f.submit "← Back", class: "w-full border-2 border-sage-300 text-sage-700 font-semibold py-4 rounded-2xl hover:bg-sage-50 transition-colors cursor-pointer mt-2"
