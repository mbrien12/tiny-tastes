%div.text-center.mb-10
  %div.mb-4
    %span.text-5xl 🥕
  %h1.text-3xl.font-bold.text-sage-800.mb-2
    TinyTastes
  %p.text-sage-600.max-w-md.mx-auto
    Fresh, nutritious weekly meal boxes for children aged 0–3, delivered to your door. Set up your plan in 3 easy steps.

.bg-white.rounded-3xl.shadow-md.p-8.mt-8

  %h2.text-xl.font-semibold.text-sage-800.mb-1 Let's get started
  %p.text-sm.text-sage-500.mb-6 Step 1 of 3 — Personal details

  - if defined?(@user) && @user&.errors&.any?
    .bg-red-50.border.border-red-200.rounded-xl.p-4.mb-6
      %ul.list-disc.list-inside.text-sm.text-red-700
        - @user.errors.full_messages.each do |msg|
          %li= msg

  = form_with url: onboardings_path, method: :post, class: "space-y-5" do |f|
    = render "personal_form", user: @user || User.new
