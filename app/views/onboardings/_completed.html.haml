.text-center.py-8
  %div.text-6xl.mb-4 🎉
  %h2.text-2xl.font-bold.text-sage-800.mb-2
    You're all set, #{@user.first_name}!
  %p.text-sage-600.mb-8
    Your first box of
    %strong= @user.plan.name
    meals will arrive on
    %strong= @user.start_date.strftime("%d %B %Y")
    \.

  .bg-sage-50.rounded-2xl.p-6.text-left.mb-8
    %h3.font-semibold.text-sage-700.mb-3 What happens next?
    %ul.space-y-3
      %li.flex.gap-3
        %span.text-lg 📦
        %div
          %p.font-medium.text-sage-800 We prepare your box
          %p.text-sm.text-sage-500 Our chefs will select the freshest seasonal ingredients for #{@user.first_name}'s meals.
      %li.flex.gap-3
        %span.text-lg 🚚
        %div
          %p.font-medium.text-sage-800 We deliver to you
          %p.text-sm.text-sage-500 Chilled and ready to warm, delivered to #{@user.address_line_1}.
      %li.flex.gap-3
        %span.text-lg ❤️
        %div
          %p.font-medium.text-sage-800 Your baby enjoys
          %p.text-sm.text-sage-500 Nutritious, chef-designed meals crafted for little ones.

  %p.text-sm.text-sage-400
    A confirmation has been sent to
    %strong= @user.email
